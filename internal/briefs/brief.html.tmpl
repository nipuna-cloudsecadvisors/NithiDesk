<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<style>
{{.FontCSS}}
@page { size: A4 landscape; margin: 9mm 8mm 12mm 8mm; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { font-family: 'ND Sinhala', 'ND Latin'; font-size: 7.6pt; line-height: 1.3; color: #000; background: #fff; }
header.brief { border-bottom: 1.5pt solid #000; padding-bottom: 2mm; margin-bottom: 2mm; display: flex; justify-content: space-between; gap: 6mm; }
header.brief h1 { font-size: 13pt; margin: 0 0 1mm 0; font-weight: 700; }
header.brief .meta { text-align: right; }
.confidential { font-weight: 700; }
section.day { break-before: page; }
section.day:first-of-type { break-before: auto; }
h2 { font-size: 10.5pt; margin: 2mm 0 0.5mm 0; break-after: avoid; }
.summary { margin: 0 0 1.5mm 0; color: #222; break-after: avoid; }
table { width: 100%; border-collapse: collapse; table-layout: fixed; }
thead { display: table-header-group; }
thead .wm th { font-weight: 400; font-size: 6.8pt; text-align: left; border: none; padding: 0 0 1mm 0; color: #333; }
thead .cols th { background: #e6e6e6; border: 0.6pt solid #555; text-align: left; font-weight: 700; padding: 1mm; vertical-align: bottom; }
td { border: 0.6pt solid #777; padding: 0.8mm 1mm; vertical-align: top; overflow-wrap: anywhere; }
tr { break-inside: avoid; page-break-inside: avoid; }
tr.court th { text-align: left; background: #f2f2f2; border: 0.6pt solid #555; padding: 1mm; font-size: 8.4pt; break-after: avoid; page-break-after: avoid; }
.sub { display: block; color: #333; }
.strong { font-weight: 700; }
.restricted { font-style: italic; }
.flag { display: block; font-weight: 700; }
.verify { display: block; }
.verify svg { width: 8pt; height: 8pt; vertical-align: -1pt; margin-right: 0.8mm; }
.empty { font-style: italic; padding: 2mm 0; }
col.c-time { width: 7%; } col.c-case { width: 11%; } col.c-parties { width: 16%; } col.c-purpose { width: 9%; }
col.c-verify { width: 9%; } col.c-prep { width: 7%; } col.c-appearing { width: 10%; } col.c-last { width: 16%; }
col.c-instr { width: 15%; }
</style>
</head>
<body>
<header class="brief">
  <div>
    <h1>{{.Title}}</h1>
    <div>{{.Range}}</div>
    <div>{{.Scope}}</div>
  </div>
  <div class="meta">
    <div>{{.PreparedFor}}</div>
    <div>{{.Generated}}</div>
    <div class="confidential">{{.Watermark}}</div>
  </div>
</header>
{{- $cols := .Cols}}{{$wm := .Watermark}}
{{- range .Days}}
<section class="day">
  <h2>{{.Heading}}</h2>
  <div class="summary">{{.Summary}}</div>
  {{- if .Empty}}
  <div class="empty">{{.Empty}}</div>
  {{- else}}
  <table>
    <colgroup><col class="c-time"><col class="c-case"><col class="c-parties"><col class="c-purpose"><col class="c-verify"><col class="c-prep"><col class="c-appearing"><col class="c-last"><col class="c-instr"></colgroup>
    <thead>
      <tr class="wm"><th colspan="9">{{$wm}}</th></tr>
      <tr class="cols">{{range $cols}}<th>{{.}}</th>{{end}}</tr>
    </thead>
    {{- range .Courts}}
    <tbody>
      <tr class="court"><th colspan="9">{{.Name}} ({{.Count}})</th></tr>
      {{- range .Rows}}
      <tr>
        <td><span class="strong">{{if .Time}}{{.Time}}{{else}}—{{end}}</span><span class="sub">{{.Session}}</span>{{if .Courtroom}}<span class="sub">{{.Courtroom}}</span>{{end}}</td>
        <td><span class="strong">{{.CaseNumber}}</span><span class="sub">{{.MatterNumber}}</span></td>
        <td{{if .Restricted}} class="restricted"{{end}}>{{.Parties}}</td>
        <td>{{.Purpose}}{{if .Status}}<span class="flag">{{.Status}}</span>{{end}}</td>
        <td><span class="verify">{{if eq .VerifyClass "ok"}}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8.5l4 4 8-9" fill="none" stroke="#000" stroke-width="2.2"/></svg>{{else if eq .VerifyClass "conf"}}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5L15 14.5H1z" fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 6v4.2M8 11.6v1.4" stroke="#000" stroke-width="1.6"/></svg>{{else}}<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.8" fill="none" stroke="#000" stroke-width="1.4"/><path d="M5.9 6.1a2.1 2.1 0 1 1 3 1.9c-.6.3-.9.8-.9 1.4v.6M8 11.6v1.4" fill="none" stroke="#000" stroke-width="1.4"/></svg>{{end}}<span class="strong">{{.Verify}}</span></span>{{if .Overdue}}<span class="flag">{{.Overdue}}</span>{{end}}</td>
        <td>{{.Prep}}</td>
        <td>{{.Appearing}}{{if .Clash}}<span class="flag">{{.Clash}}</span>{{end}}</td>
        <td>{{if .LastOutcome}}<span class="strong">{{.LastDate}}: {{.LastOutcome}}</span>{{if .LastSummary}}<span class="sub">{{.LastSummary}}</span>{{end}}{{if .LastOrder}}<span class="sub"><span class="strong">{{.OrderLabel}}:</span> {{.LastOrder}}</span>{{end}}{{else}}—{{end}}</td>
        <td>{{if .Instructions}}{{.Instructions}}{{else}}—{{end}}</td>
      </tr>
      {{- end}}
    </tbody>
    {{- end}}
  </table>
  {{- end}}
</section>
{{- end}}
</body>
</html>
